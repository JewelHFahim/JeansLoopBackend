# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/jeansloop

# ─── JWT (REQUIRED — app will NOT start if these are missing) ──
JWT_SECRET=change_me_to_a_64_char_random_string_in_production
JWT_REFRESH_SECRET=change_me_to_another_64_char_random_string_in_production
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# ─── CORS (comma-separated list of allowed origins) ────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── File Storage ──────────────────────────────────────────
# STORAGE_TYPE: LOCAL | CLOUDINARY
STORAGE_TYPE=LOCAL
BACKEND_URL=http://localhost:5000

# For Cloudinary (only needed if STORAGE_TYPE=CLOUDINARY)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# ─── Seed Scripts (only for seed:admin command) ────────────
SEED_ADMIN_EMAIL=admin@jeansloop.com
SEED_ADMIN_PASSWORD=ChangeMe_Str0ng_P@ssword
